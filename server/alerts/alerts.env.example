# The push alerts' own settings. Copy to /etc/fourgames/alerts.env (readable only by root and fourgames):
#   sudo install -m 640 -o root -g fourgames /srv/fourgames/own/server/alerts/alerts.env.example /etc/fourgames/alerts.env
#   sudo nano /etc/fourgames/alerts.env
# Never commit the filled-in file. A blank value means the default shown in the comment.
#
# The rest comes from /etc/fourgames/feedback.env, which the service reads first: TWITCH_CLIENT_ID and
# TWITCH_CLIENT_SECRET (for Twitch's subscription), and for the check itself the same
# DISCORD_RELEASES_WEBHOOK_URL and YOUTUBE_API_KEY the loop uses.

# Where Caddy serves this service, without a trailing slash. YouTube calls PUBLIC_BASE_URL/youtube and
# Twitch PUBLIC_BASE_URL/twitch; both must be HTTPS.
PUBLIC_BASE_URL=https://api.fourgames.se/alerts

# Signs YouTube's notifications. Make one with: openssl rand -hex 32. Blank: no YouTube pushes.
YOUTUBE_WEBSUB_SECRET=
# Signs Twitch's notifications. Make one with: openssl rand -hex 32. Blank: no Twitch pushes.
TWITCH_EVENTSUB_SECRET=

# Seconds after a push to check, one check per value (default 30,150): YouTube's API can take a moment
# to call a stream live, and Twitch's to list it. Pushes close together share their checks.
CHECK_DELAYS=30,150
# A check still running after this many seconds is stopped (default 900).
CHECK_TIMEOUT=900
# The YouTube subscription lasts about 5 days; it's renewed after half of that, or this many hours
# if sooner (default 72).
RENEW_HOURS=72

# The `own` checkout's feedback folder and the loop's interpreter, which run the check.
FEEDBACK_DIR=/srv/fourgames/own/feedback
FEEDBACK_PYTHON=/srv/fourgames/venv/bin/python

# The channel and login (the same as in feedback/announce.py).
YOUTUBE_CHANNEL_ID=UCGf6yX8yYzo1FBzhmKhFduA
TWITCH_LOGIN=fourgamesab

# Listens here, on localhost only.
PORT=8102
