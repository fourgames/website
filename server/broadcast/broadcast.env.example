# /etc/fourgames/broadcast/<name>.env, one per stream (root:fourgames, 640). <name> is the
# service instance: steam-broadcast@<name>.
# From steamcommunity.com/broadcast/upload (signed in as the streaming account): the "Upload Server"
# and the RTMP token. The token is a password: never in git or chat.
# Copy it exactly as the page shows it (Steam picks a server near this one).
STEAM_RTMP_URL=
STEAM_STREAM_KEY=
# The file made by prepare.sh.
VIDEO=/srv/fourgames/broadcast/pomo-valley.mp4
