# The contact form's settings. Copy to /etc/fourgames/contact.env (readable only by root and fourgames):
#   sudo install -m 640 -o root -g fourgames /srv/fourgames/own/server/contact/contact.env.example /etc/fourgames/contact.env
#   sudo nano /etc/fourgames/contact.env
# Never commit the filled-in file. A blank value means the default shown in the comment.

# The mailbox that sends the messages (Strato: Email → the mailbox → its password).
# SMTP_HOST default smtp.strato.com, SMTP_PORT default 587 (STARTTLS).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Where messages go (default support@fourgames.se) and who they're from (default SMTP_USER; the
# mailbox must be allowed to send as it, so the mailbox itself or one of its aliases).
# Replying in the mail app goes to the person who wrote (Reply-To).
CONTACT_TO=
CONTACT_FROM=

# Optional: a Discord webhook (channel → Edit Channel → Integrations → Webhooks) for a short
# "new message from someone at studio.com, subject: …" notice. Never the message or the address.
CONTACT_DISCORD_WEBHOOK_URL=

# Sites that may post, comma-separated (default https://fourgames.se). For trying the form from
# `npm run dev` / `npm run preview`, add http://localhost:5173,http://localhost:4173.
CONTACT_ALLOWED_ORIGINS=

# Anti-spam: the fewest seconds between the form showing and being sent (default 3), and at most
# CONTACT_RATE_LIMIT messages per IP per CONTACT_RATE_WINDOW seconds (default 5 per 3600).
CONTACT_MIN_SECONDS=
CONTACT_RATE_LIMIT=
CONTACT_RATE_WINDOW=

# Only Caddy on the same machine talks to it (defaults 127.0.0.1 and 8101).
HOST=
PORT=
