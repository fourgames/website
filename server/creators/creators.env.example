# The creator collector's settings. Copy to /etc/fourgames/creators.env (readable only by root and fourgames):
#   sudo install -m 640 -o root -g fourgames /srv/fourgames/own/server/creators/creators.env.example /etc/fourgames/creators.env
#   sudo nano /etc/fourgames/creators.env
# Never commit the filled-in file. A blank value means the default.

# A YouTube Data API v3 key from a NEW Google Cloud project, not the feedback loop's: the quota
# (10,000 units a day) is per project, and the feedback loop's media search already uses most of its own.
YOUTUBE_API_KEY=

# Units to spend a day, of the 10,000. A game search costs 100, so 9,500 is ~90 games a day.
DAILY_UNITS=9500

# The databases.
DB_PATH=/srv/fourgames/creators/creators.db
STEAM_DB=/srv/fourgames/steamdata/steam.db

# Our own games, comma-separated app ids. Blank: read from the website's src/data/games.js.
OWN_APPIDS=

# Games whose developer or publisher is exactly this name are ours too (with OWN_APPIDS).
OWN_STUDIO=Four Games

# A game is searched again after this many days (our own games every 7).
RESEARCH_DAYS=30
# The first search of a game looks back this many days.
LOOKBACK_DAYS=180
# Only games with at least this many Steam reviews are searched.
MIN_REVIEWS=30
# Games with more reviews than this are skipped (Counter-Strike 2 and the like): their videos come from
# channels too big to answer a small studio, and from esports channels.
MAX_REVIEWS=50000
# Games over this full price in US cents are skipped too: new AAA releases that don't have the reviews yet.
MAX_PRICE=3000
# Channel details (subscribers, description, emails) are read again after this many days.
CHANNEL_REFRESH_DAYS=30

LOG_LEVEL=INFO
