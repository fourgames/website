# Outreach sending (creators/send.py), copied to /etc/fourgames/outreach.env (640 root:fourgames).
# The mailbox that sends and receives: your Strato mailbox and its password. Put the password in
# yourself (sudo nano /etc/fourgames/outreach.env); without both nothing is sent or read.
MAIL_USER=
MAIL_PASSWORD=
# Strato's servers (the defaults).
SMTP_HOST=smtp.strato.com
SMTP_PORT=587
IMAP_HOST=imap.strato.com
IMAP_PORT=993
# At most this many emails a day across all campaigns. Start low (20-40) on a mailbox that hasn't
# sent much before and raise it over a few weeks; spam filters watch sudden jumps.
DAILY_MAX=30
# Local hours to send in, weekdays only, e.g. 9-18 (from 9:00 to before 18:00).
SEND_HOURS=9-18
TIMEZONE=Europe/Stockholm
# The creators database (the default).
DB_PATH=/srv/fourgames/creators/creators.db
