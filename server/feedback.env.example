# The feedback loop's secrets on the server, the same ones as the GitHub Actions secrets.
# feedback-setup.sh copies this to /etc/fourgames/feedback.env (readable only by root and fourgames);
# fill it in there with: sudo nano /etc/fourgames/feedback.env
# GitHub never shows a secret again once it's saved, so take each value from where you made it.
# Never commit the filled-in file.

STEAM_PUBLISHER_KEY=
# The server has a fixed IP, so this key's IP list in Steamworks can now be set to it.
STEAM_FINANCIAL_KEY=
ANTHROPIC_API_KEY=
DISCORD_WEBHOOK_URL=
DISCORD_MENTION=
DISCORD_RELEASES_WEBHOOK_URL=
DISCORD_RELEASES_ROLE=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
GEMINI_API_KEY=
# Several feeds on one line, separated by spaces, in double quotes: "https://… https://…"
GOOGLE_ALERTS_FEEDS=

# A fine-grained GitHub token (github.com/settings/personal-access-tokens), resource owner
# fourgames, repository fourgames/website only, permission Actions: Read and write. loop.sh uses it to
# start the site's rebuild when a store page changes.
GH_TOKEN=
