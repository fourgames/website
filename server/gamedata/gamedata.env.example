# The player game-data API's settings. Copy to /etc/fourgames/gamedata.env (readable only by root and fourgames):
#   sudo install -m 640 -o root -g fourgames /srv/fourgames/own/server/gamedata/gamedata.env.example /etc/fourgames/gamedata.env
#   sudo nano /etc/fourgames/gamedata.env
# Never commit the filled-in file. A blank value means the default shown in the comment.

# Four secrets, each made with: openssl rand -hex 32 (at least 32 characters, all different).
#
# The pepper turns a SteamID into the pseudonym the data is stored under:
# pid = HMAC-SHA256(GAMEDATA_PEPPER, "steam:" + steamid64). It lives only here.
# SET IT ONCE AND NEVER CHANGE IT: a new pepper gives every player a new pid, so nobody could find,
# download or anonymise their earlier data any more. Keep a copy somewhere safe (a password manager).
GAMEDATA_PEPPER=
# Signs the privacy page's sign-in cookie. Changing it only signs everyone out.
GAMEDATA_COOKIE_SECRET=
# Signs the games' session tokens. Changing it makes running games start a new session.
GAMEDATA_TOKEN_SECRET=
# Our own tools on this machine send it as X-Internal-Key to POST /v1/internal/lookup (game data next
# to a Steam review's author). Caddy keeps /gamedata/v1/internal/* closed from outside.
GAMEDATA_INTERNAL_KEY=

# The Steamworks publisher Web API key (Users & Permissions → Manage Groups → the group → Web API
# key), for checking the games' auth tickets and ownership. The same key as in feedback.env works.
STEAM_PUBLISHER_KEY=

# The Steam app ids of the games that may send data, comma-separated. Empty (the default): none, so
# every session start is refused until a game is added. A demo is just another app id here.
# Restart the service after a change.
GAMEDATA_APP_IDS=
# Optional, test mode: app ids (comma-separated) whose sessions are only taken from the Steam accounts
# in GAMEDATA_TEST_STEAMIDS (SteamID64s, 17 digits, comma-separated). Those sessions are marked test:
# the player sees and downloads them as usual, the internal lookup leaves them out. Anyone else is
# told the app is unknown. An app in both lists takes everyone, and marks only the testers' sessions.
# Steam's ownership check still applies. Empty (the default): no test mode. Restart after a change.
GAMEDATA_TEST_APP_IDS=
GAMEDATA_TEST_STEAMIDS=
# Optional: which app id is the demo of which game, as demo_app_id:game_app_id pairs separated by
# commas. A demo's session start then also asks Steam whether the player owns the game, and the
# summaries show "played the demo, owns the game".
GAMEDATA_DEMO_OF=

# Where the database and the files go (default /srv/fourgames/gamedata).
DATA_DIR=

# Where the API is reached from outside (default https://api.fourgames.se/gamedata): the sign-in
# comes back to PUBLIC_BASE_URL/v1/auth/callback, and the cookie's domain is its host.
PUBLIC_BASE_URL=
# The privacy page's site, the only origin that may call the player endpoints (default
# https://fourgames.se), and the page the games link to (default SITE_ORIGIN/privacy).
SITE_ORIGIN=
PRIVACY_URL=

# Nothing is ever deleted automatically. This many months after a player's last session (default
# 24), their data is anonymised (moved to a random pid that nothing links to them); it all stays.
GAMEDATA_LINK_MONTHS=

# DB-IP's free city database for the country and region at session start (default
# DATA_DIR/geo/dbip-city-lite.mmdb). gamedata-geo.timer keeps it up to date; without the file both
# are empty and everything else works. Its data is CC BY 4.0: credit "IP Geolocation by DB-IP"
# (https://db-ip.com) where it's shown.
GEOIP_DB=

# What the games are told at session start: upload every N seconds (default 60) and at most N KB of
# gzip per batch (default 256; bigger batches are refused with 413).
GAMEDATA_UPLOAD_EVERY_S=
GAMEDATA_MAX_BATCH_KB=

# Limits that protect the box: at most this many MB of gzipped events per player per day (default
# 50), and no uploads while the disk has less than this many MB free (default 2048).
GAMEDATA_MAX_MB_PER_DAY=
GAMEDATA_MIN_FREE_MB=

# Only Caddy on the same machine talks to it (defaults 127.0.0.1 and 8103).
HOST=
PORT=
