# The key bot's settings. Copy to /etc/fourgames/keybot.env (readable only by root and fourgames):
#   sudo install -m 640 -o root -g fourgames /srv/fourgames/own/server/keybot/keybot.env.example /etc/fourgames/keybot.env
#   sudo nano /etc/fourgames/keybot.env
# Never commit the filled-in file. A blank value means the default shown in the comment.

# Discord Developer Portal → the "Four Games" application.
# Bot → Reset Token.
DISCORD_BOT_TOKEN=
# General Information → Application ID.
DISCORD_CLIENT_ID=
# OAuth2 → Client Secret (for the creators' "Verify your channel" login).
DISCORD_CLIENT_SECRET=

# The Four Games server.
GUILD_ID=1084592623819444365
# The role Discord's YouTube integration gives channel members: its id, or its exact name.
MEMBER_ROLE=YouTube Member
# The private channel where creator and press requests show up with Approve / Deny, and the
# low-stock alerts. Keep it to the team: press requests include email addresses.
ADMIN_CHANNEL_ID=
# Who may use /keys and the Approve / Deny buttons, besides anyone with Manage Server. Optional.
ADMIN_ROLE_ID=

# Where Caddy serves the bot's web side, without a trailing slash. Discord sends creators back to
# PUBLIC_BASE_URL/callback, which must be listed under OAuth2 → Redirects.
PUBLIC_BASE_URL=https://api.fourgames.se/keybot
# Signs the verify links. Make one with: openssl rand -hex 32
STATE_SECRET=

# Looking up creators' channels: the same values as in /etc/fourgames/feedback.env work.
# Google Cloud → APIs & Services → Credentials, with YouTube Data API v3 enabled.
YOUTUBE_API_KEY=
# dev.twitch.tv/console → Applications.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# A creator gets a key without review when one verified channel has at least this many
# subscribers (YouTube, with an upload in the last MAX_DAYS_SINCE_UPLOAD days) or followers (Twitch).
MIN_YOUTUBE_SUBSCRIBERS=1000
MIN_TWITCH_FOLLOWERS=500
MAX_DAYS_SINCE_UPLOAD=60

# The admin channel hears about it when a game drops below this many keys, at 10% of the keys
# imported for it, and when it runs out.
LOW_STOCK=5

# 1 turns on /keys grant role: (a key for everyone with a role). It needs the member list: switch on
# Bot → Privileged Gateway Intents → Server Members Intent in the Developer Portal first, or the
# bot can't log in. Blank or 0: off, and the bot asks for no privileged intents.
GRANTROLE_ENABLED=

# The database: one SQLite file (back up this file; while the bot runs, use sqlite3's .backup).
DB_PATH=/srv/fourgames/keybot/keys.db
# The web side listens here, on localhost only.
PORT=8100
