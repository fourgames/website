# The fan mailing list's settings (server/news). Copy to /etc/fourgames/news.env:
#   sudo install -m 640 -o root -g fourgames /srv/fourgames/own/server/news/news.env.example /etc/fourgames/news.env
# The mailbox and its password (MAIL_USER, MAIL_PASSWORD, SMTP_HOST, SMTP_PORT) come from
# /etc/fourgames/outreach.env, the same Strato mailbox the creator outreach sends from, so they
# aren't repeated here. A blank value means the default shown in the comment.

# Who the confirm emails come from. It must be the mailbox itself or one of its aliases: add the
# alias news@fourgames.se to the mailbox in Strato (Email → the mailbox → Aliases) first.
# Default: MAIL_USER.
NEWS_FROM=news@fourgames.se
# The name shown next to it (default Four Games).
NEWS_FROM_NAME=

# Sites that may sign up, comma-separated (default https://fourgames.se).
NEWS_ALLOWED_ORIGINS=

# Anti-spam: the fewest seconds between the form showing and being sent (default 1.5), at most
# NEWS_RATE_LIMIT signups per IP per NEWS_RATE_WINDOW seconds (default 5 per 3600), and at most
# NEWS_DAILY_MAX confirm emails a day in all (default 200).
NEWS_MIN_SECONDS=
NEWS_RATE_LIMIT=
NEWS_RATE_WINDOW=
NEWS_DAILY_MAX=

# Where the list (news.db) and the dashboard's numbers (stats.json) live (default /srv/fourgames/news),
# and the public address of this service for the links in the emails (default https://api.fourgames.se/news).
NEWS_DIR=
NEWS_PUBLIC_URL=

# Only Caddy on the same machine talks to it (defaults 127.0.0.1 and 8104).
NEWS_HOST=
NEWS_PORT=
