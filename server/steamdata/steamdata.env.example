# The Steam market-data collector's settings. Copy to /etc/fourgames/steamdata.env (readable only
# by root and fourgames):
#   sudo install -m 640 -o root -g fourgames /srv/fourgames/own/server/steamdata/steamdata.env.example /etc/fourgames/steamdata.env
#   sudo nano /etc/fourgames/steamdata.env
# Never commit the filled-in file. A blank value means the default shown. No spaces in values.

# A Steam Web API key, only for the list of every game on the store (IStoreService/GetAppList, about
# 25 calls a day). Get an ordinary one at https://steamcommunity.com/dev/apikey (domain: fourgames.se).
# The Steamworks publisher key would work too, but keep that one to the feedback loop (see the README).
# Blank: no app list; only the games already in the database and PCGamingWiki's are collected.
STEAM_WEB_API_KEY=

# The database: one SQLite file (back up this file; while it runs, use sqlite3's .backup).
DB_PATH=/srv/fourgames/steamdata/steam.db

# Prices are the store's for this country, in cents of its currency. Don't change it once data is
# collected, or the daily prices mix currencies.
COUNTRY=US

# The pace. api.steampowered.com (app list, daily snapshots, player counts): the Steam Web API terms
# allow 100,000 calls a day, and 60 a minute is at most 86,400. At most 69.
WEBAPI_PER_MINUTE=60
# store.steampowered.com/api/appdetails (full metadata): Steam allows about 200 per 5 minutes. At most 200.
APPDETAILS_PER_5MIN=120
# www.pcgamingwiki.com: one request per this many seconds.
PCGW_SECONDS=10

# The full metadata (genres, languages, legal notice...) is fetched again every this many days.
DETAILS_DAYS=30

# PCGamingWiki engine pages whose games are collected as engine signals, comma-separated
# (Godot = Engine:Godot). The Godot ones make the Godot set, sampled most often.
PCGW_ENGINES=Godot

# Delete raw player-count samples older than this many days (the daily peak stays). 0: keep all.
SAMPLES_KEEP_DAYS=0

# DEBUG logs every request; INFO a summary every 10 minutes.
LOG_LEVEL=INFO

# The Market numbers (python -m steamdata.market, steamdata-market.timer):
# where the files go (the game-data API reads them from here too; default below),
MARKET_DIR=/srv/fourgames/steamdata/market
# and a Discord webhook for new market alerts (Server Settings > Integrations > Webhooks in the
# channel you want them in). Empty: no posts; the alerts are still in the dashboard.
MARKET_DISCORD_WEBHOOK=
